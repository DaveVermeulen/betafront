{
  "schemaVersion": 1,
  "id": "betafront",
  "version": "${version}",

  "name": "Betafront",
  "description": "Wavefront OBJ block and item models for StationAPI. Point a model JSON at an .obj file with \"loader\": \"betafront:obj\".",
  "authors": [
    "Dave"
  ],
  "contributors": [
    "OBJ parsing adapted from NeoForge (Forge Development LLC and contributors)"
  ],
  "contact": {
    "sources": "https://github.com/DaveVermeulen/objmodelsbabric",
    "issues": "https://github.com/DaveVermeulen/objmodelsbabric/issues"
  },

  "license": "LGPL-2.1-only",

  "environment": "*",
  "entrypoints": {
    "stationapi:event_bus": [
      "io.github.davevermeulen.betafront.example.ExampleContent"
    ],
    "stationapi:event_bus_client": [
      "io.github.davevermeulen.betafront.client.ObjModelsClient"
    ]
  },

  "depends": {
    "minecraft": "1.0.0-beta.7.3",
    "fabricloader": ">=${loader_version}",
    "stationapi": ">=${stationapi_version}"
  }
}
